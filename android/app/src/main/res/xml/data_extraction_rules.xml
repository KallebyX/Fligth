<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Disable auto-backup of user data. We don't want auth tokens leaking
         into Google Drive backups; the source of truth is Supabase. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
