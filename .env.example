NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
CRON_SECRET=replace-with-long-random-string

# Stripe (web payments) — test mode for dev, live mode for production
STRIPE_SECRET_KEY=sk_test_or_live_...
# Webhook signing secret. Get with `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# or from the Stripe dashboard → Developers → Webhooks → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# RevenueCat (native IAP — StoreKit on iOS, Play Billing on Android)
# Public API keys (different per platform) — these go into the device.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxx
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx
# Custom Authorization header value you set in RevenueCat dashboard → Integrations → Webhooks.
REVENUECAT_WEBHOOK_TOKEN=replace-with-long-random-token
# Once a TestFlight/Closed Track build is uploaded with IAP working, set this to "true"
# so the BuyButton actually calls StoreKit/Play Billing instead of showing the
# "use the browser" notice.
NEXT_PUBLIC_NATIVE_IAP_ENABLED=false

# Sentry — error tracking + performance
# DSN é seguro expor no client.
NEXT_PUBLIC_SENTRY_DSN=https://c42dfcec2237daff61c10420fd22aec4@o4511339402493952.ingest.us.sentry.io/4511394604056576
# Auth token de upload de source maps. Gere em https://sentry.io/settings/account/api/auth-tokens/
# com scope project:write. Apenas em CI/Vercel — NÃO commit.
SENTRY_AUTH_TOKEN=
